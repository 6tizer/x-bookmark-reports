# TwitterAPI.io API Key（必填）
# 获取地址: https://twitterapi.io/dashboard
TWITTER_API_IO_KEY=

# 书签数据文件路径（相对于 x-bookmark-reports/ 目录，或使用绝对路径）
# 默认：data/bookmarks.json
# 示例：../twitter_data/bookmarks.json
BOOKMARKS_PATH=../twitter_data/bookmarks.json

# 代理（可选，与 bookmarks/.env.twitter 保持一致）
PROXY=http://127.0.0.1:7897

# 产品时区（可选，IANA 名，默认 Asia/Singapore）
# 所有面向用户的日期（Notion「发布时间」、报告日期、Dashboard 展示）按此时区取日历日；
# 机器时间戳（state 文件 last_run 等）仍保存为 ISO 带偏移，不受影响。UI 侧常量在 ui/src/lib/format-date.ts。
# APP_TIMEZONE=Asia/Singapore

# Rettiwt / 同步脚本用 Cookie（可选；仅 sync_bookmarks.sh 等需要，Python 报告可不填）
# API_KEY=

# 可选元数据（用于 get_config()；README 抓取从 URL 解析 owner/repo，可不填）
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BRANCH=main

# Notion Integration（上传书签草稿到 Notion DB）
# Integration Token：在 https://www.notion.so/my-integrations 创建，并将 Integration 加入目标 DB 的分享权限
NOTION_TOKEN=
# 目标 Database ID：从 Notion DB 页面 URL 中提取（32 位十六进制字符串）
NOTION_DB_ID=
# 是否真实上传：false = dry-run（只打印），true = 写入 Notion
# 初始保持 false，审查 bin/upload_to_notion.py 后改为 true 激活
NOTION_UPLOAD_LIVE=false

# ===========================
# Article Pipeline — 成文管线
# ===========================

# DeepSeek — 文章改写（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# x.ai — 研究搜索（Responses API + web_search + x_search）
# 获取地址: https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

# Exa — 可选补充（/search REST，非 Research 模型；exa-research 已退役）
# 获取地址: https://dashboard.exa.ai
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# SearXNG — 主力搜索（自托管实例，无需 key）
# 自托管 SearXNG 实例地址（tailnet 内网），如 http://<host>:8888；留空则跳过 SearXNG，走 Firecrawl 备路
SEARXNG_BASE_URL=

# Firecrawl — 备用搜索（SearXNG 失败或 0 结果时启用；API Key 可留空走 Keyless）
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
# Firecrawl 单进程调用预算帽（默认 50）；达到后本进程不再调用，防止额度烧穿
FIRECRAWL_MAX_CALLS_PER_RUN=50

# Cloudflare Browser Run — 无头浏览器渲染提取 Markdown（Step 2 动态外链兜底）
# 权限要求：Browser Run - Edit（或 Browser Rendering - Edit）；未填时自动回退读取 cache/.cf_browser_token
CF_ACCOUNT_ID=
CF_BROWSER_API_TOKEN=
CF_BROWSER_ENABLED=1
CF_BROWSER_MAX_CALLS_PER_RUN=20
CF_BROWSER_DAILY_MS_BUDGET=480000

# ===========================
# 官方书签对账（默认关闭）
# ===========================
# 用 X 官方 /2/users/:id/bookmarks 探测 rettiwt 漏抓，再按 id 用 rettiwt 回填。
# 官方端点按返回条数计费：Owned Reads $0.001/条（24h UTC 去重），非 Owned Reads $0.005/条。
# 默认 0；设为 1 后 auto_run.sh 会在 Step 1 与 Step 2 之间调用。
OFFICIAL_RECONCILE_ENABLED=0
OFFICIAL_RECONCILE_MAX_RESULTS=50
OFFICIAL_RECONCILE_MAX_PAGES=1
OFFICIAL_RECONCILE_USER_ID=
OFFICIAL_RECONCILE_XURL_APP=default
OFFICIAL_RECONCILE_XURL_USER=

# 成文输出目录（相对于项目根目录）
ARTICLE_FINAL_DIR=output/article-final

# Dashboard Articles 展示目录（设为成文输出即可在 UI 中展示）
ARTICLES_DIR=output/article-final

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Next.js Dashboard (port 3001)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/ui",
        "env": {
          "NO_PROXY": "127.0.0.1,localhost,::1,0.0.0.0",
          "no_proxy": "127.0.0.1,localhost,::1,0.0.0.0"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Next.js Dashboard (clean .next + dev)",
      "type": "shell",
      "command": "npm run dev:clean",
      "options": {
        "cwd": "${workspaceFolder}/ui",
        "env": {
          "NO_PROXY": "127.0.0.1,localhost,::1,0.0.0.0",
          "no_proxy": "127.0.0.1,localhost,::1,0.0.0.0"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Streamlit UI",
      "type": "shell",
      "command": "python3 -m streamlit run app.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}

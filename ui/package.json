{
  "name": "x-bookmark-reports-ui",
  "version": "1.0.0",
  "description": "Notion-style UI for x-bookmark-reports",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "env NO_PROXY=127.0.0.1,localhost,::1,0.0.0.0 no_proxy=127.0.0.1,localhost,::1,0.0.0.0 next dev -H 0.0.0.0 -p 3001",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "env NO_PROXY=127.0.0.1,localhost,::1,0.0.0.0 no_proxy=127.0.0.1,localhost,::1,0.0.0.0 next start -H 0.0.0.0 -p 3001",
    "lint": "next lint",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "better-sqlite3": "^11.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.2.12",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "node-cron": "^4.2.1",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5"
  }
}
